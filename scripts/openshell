#!/usr/bin/env bash
set -euo pipefail
umask 077

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd "$script_dir/.." && pwd)"
cd "$repo_root"

usage() {
  cat <<'EOF'
usage: ./scripts/openshell [up|test|info|down|help]
       ./scripts/openshell get <field>

Commands:
  up    Prepare or reuse an owned OpenShell v0.1.0-pre.7 verification
        environment. This is the default command.
  test  Prepare or reuse the environment, then run the real model, identity,
        filesystem, network, replacement, and cleanup proof.
  get   Print one non-secret prepared value. Fields: kubeconfig, context.
  info  Show the selected engine and prepared environment without printing
        credentials or database URLs.
  down  Remove only the cluster, images, and PostgreSQL resources recorded in
        this helper's owned state.
  help  Show this help.

The helper detects a running Podman API socket or Docker daemon. Set
OCC_OPENSHELL_CONTAINER_ENGINE=podman or docker to select one explicitly.
Set OCC_OPENSHELL_K3D_BIN to a working k3d executable when PATH resolves to a
version-manager shim without an active version.
Set OCC_OPENSHELL_COREPACK_BIN the same way when corepack resolves to an
inactive shim.
Provide OPENAI_API_KEY in the environment, let an interactive terminal prompt
for it, or set OCC_OPENSHELL_ENV_FILE to an absolute private dotenv file.
OCC_TEST_OPENAI_MODEL defaults to gpt-6-astra.

This workflow uses the verification-only compatibility bridge for OpenShell
v0.1.0-pre.7. It does not make OpenShell a supported production Agent runtime.
EOF
}

fail() {
  echo "openshell: $*" >&2
  exit 1
}

info() {
  printf '[openshell:%s] %s\n' "$engine" "$*"
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || fail "$1 is required on PATH"
}

select_k3d() {
  local selected="${OCC_OPENSHELL_K3D_BIN:-k3d}"
  if [[ "$selected" == */* ]]; then
    [ -x "$selected" ] || fail "OCC_OPENSHELL_K3D_BIN must name an executable file"
    k3d_bin="$selected"
  else
    k3d_bin="$(command -v "$selected")" || fail "$selected is required on PATH"
  fi
  "$k3d_bin" version >/dev/null 2>&1 ||
    fail "k3d is not runnable; select a working executable with OCC_OPENSHELL_K3D_BIN"
}

select_corepack() {
  local selected="${OCC_OPENSHELL_COREPACK_BIN:-corepack}"
  if [[ "$selected" == */* ]]; then
    [ -x "$selected" ] || fail "OCC_OPENSHELL_COREPACK_BIN must name an executable file"
    corepack_bin="$selected"
  else
    corepack_bin="$(command -v "$selected")" || fail "$selected is required on PATH"
  fi
  "$corepack_bin" --version >/dev/null 2>&1 ||
    fail "corepack is not runnable; select a working executable with OCC_OPENSHELL_COREPACK_BIN"
}

validate_credential_env_file() {
  credential_env_file="${OCC_OPENSHELL_ENV_FILE:-}"
  [ -n "$credential_env_file" ] || return 0
  case "$credential_env_file" in
    /*) ;;
    *) fail "OCC_OPENSHELL_ENV_FILE must be absolute" ;;
  esac
  node -e '
    const { statSync } = require("node:fs");
    const path = process.argv[1];
    const info = statSync(path);
    if (!info.isFile()) throw new Error("credential environment path must be a file");
    if ((info.mode & 0o777) !== 0o600) throw new Error("credential environment file must have mode 0600");
  ' "$credential_env_file" || fail "OCC_OPENSHELL_ENV_FILE must name a mode-0600 file"
  node_command=(node "--env-file=$credential_env_file")
}

prompt_openai_api_key() {
  [ -n "${credential_env_file:-}" ] && return
  [ -n "${OPENAI_API_KEY:-}" ] && return
  [ -t 0 ] || fail "OPENAI_API_KEY or OCC_OPENSHELL_ENV_FILE is required for non-interactive use"
  printf 'OpenAI API key: ' >&2
  if ! IFS= read -r -s OPENAI_API_KEY; then
    printf '\n' >&2
    fail "OPENAI_API_KEY input was cancelled"
  fi
  printf '\n' >&2
  [ -n "$OPENAI_API_KEY" ] || fail "OPENAI_API_KEY cannot be empty"
  export OPENAI_API_KEY
}

configure_podman() {
  podman_bin="$(command -v podman)" || return 1
  podman_compose_bin="$(command -v podman-compose)" || return 1
  case "$(uname -s)" in
    Darwin)
      podman_socket="$($podman_bin machine inspect --format '{{.ConnectionInfo.PodmanSocket.Path}}' 2>/dev/null)" || return 1
      ;;
    Linux)
      podman_socket="$($podman_bin info --format '{{.Host.RemoteSocket.Path}}' 2>/dev/null)" || return 1
      ;;
    *) return 1 ;;
  esac
  podman_socket="${podman_socket#unix://}"
  [ -S "$podman_socket" ] || return 1

  engine="podman"
  engine_label="Podman"
  container_bin="$podman_bin"
  export DOCKER_HOST="unix://$podman_socket"
  export PODMAN_COMPOSE_PROVIDER="$podman_compose_bin"
}

configure_docker() {
  docker_bin="$(command -v docker)" || return 1
  "$docker_bin" info >/dev/null 2>&1 || return 1
  "$docker_bin" compose version >/dev/null 2>&1 || return 1

  engine="docker"
  engine_label="Docker"
  container_bin="$docker_bin"
  unset PODMAN_COMPOSE_PROVIDER
}

select_engine() {
  case "${OCC_OPENSHELL_CONTAINER_ENGINE:-}" in
    podman)
      configure_podman || fail "a Podman API socket and podman-compose must be running and available"
      ;;
    docker)
      configure_docker || fail "Docker and Docker Compose must be running and available"
      ;;
    "")
      case "${DOCKER_HOST:-}" in
        *podman*) configure_podman || fail "DOCKER_HOST selects Podman, but its API socket is unavailable" ;;
        ?*) configure_docker || fail "DOCKER_HOST is set, but Docker is unavailable" ;;
        *)
          if configure_podman; then
            return
          fi
          if configure_docker; then
            return
          fi
          fail "no running Podman API socket or Docker daemon was detected"
          ;;
      esac
      ;;
    *) fail "OCC_OPENSHELL_CONTAINER_ENGINE must be podman or docker" ;;
  esac
}

value_field=""
case "${1:-up}" in
  up) action="up" ;;
  test) action="test" ;;
  get)
    action="get"
    value_field="${2:-}"
    if [ -z "$value_field" ] || [ "$#" -ne 2 ]; then
      usage
      exit 2
    fi
    ;;
  info) action="info" ;;
  down) action="down" ;;
  help | -h | --help)
    usage
    exit 0
    ;;
  *)
    usage
    exit 2
    ;;
esac

require_command node
select_k3d
select_engine

node_command=(node)

export OCC_DOCKER_BIN="$container_bin"
export OPENCLAW_CI_K3D_BIN="$k3d_bin"
export OCC_TEST_OPENAI_MODEL="${OCC_TEST_OPENAI_MODEL:-gpt-6-astra}"
export OCC_TEST_OPENSHELL_SECRET_PROJECTION=1

# This developer workflow builds the current checkout and uses the pinned
# OpenShell inputs. Ignore test selectors inherited from another shell session.
unset OCC_TEST_KUBERNETES_GATEWAY_IMAGE
unset OCC_TEST_KUBERNETES_AGENT_IMAGE
unset OCC_TEST_KUBERNETES_RUNTIME_IMAGE
unset OCC_TEST_KUBERNETES_CODEX_IMAGE
unset OCC_TEST_OPENSHELL_GATEWAY_IMAGE
unset OCC_TEST_OPENSHELL_SANDBOX_IMAGE
unset OCC_TEST_OPENSHELL_SUPERVISOR_IMAGE

state_base="${XDG_STATE_HOME:-${HOME}/.local/state}"
state_dir="${OCC_OPENSHELL_STATE_DIR:-$state_base/openclaw-enterprise/openshell-$engine-pre7}"
case "$state_dir" in
  /*) ;;
  *) fail "OCC_OPENSHELL_STATE_DIR must be absolute" ;;
esac
mkdir -p "$state_dir"
chmod 700 "$state_dir"

state_file="$state_dir/state.json"
prepared_env_file="$state_dir/environment"
ready_file="$state_dir/ready"
lifecycle_lock="$state_dir/lifecycle.lock"
export RUNNER_TEMP="$state_dir"

load_environment() {
  while IFS= read -r environment_record || [ -n "$environment_record" ]; do
    [ -n "$environment_record" ] || continue
    [[ "$environment_record" =~ ^[a-zA-Z_][a-zA-Z0-9_]*= ]] || fail "prepared environment contains an invalid assignment"
    export "${environment_record?}"
  done < "$prepared_env_file"
}

validate_prepared_environment() {
  node -e '
    const { readFileSync } = require("node:fs");
    const { resolve } = require("node:path");
    const [statePath, environmentPath, repositoryRoot] = process.argv.slice(1);
    const state = JSON.parse(readFileSync(statePath, "utf8"));
    const reject = (message) => {
      console.error(`openshell: ${message}`);
      process.exit(1);
    };
    if (state.version !== 1) reject(`unsupported prepared state version: ${state.version}`);
    if (
      typeof state.repositoryRoot !== "string" ||
      state.repositoryRoot.length === 0 ||
      resolve(state.repositoryRoot) !== resolve(repositoryRoot)
    ) {
      reject("prepared state belongs to another repository checkout");
    }
    if (state.lane !== "openshell") reject("prepared state is not for OpenShell");
    if (!state.prefix?.startsWith("openclaw-ci-") || !Array.isArray(state.resources)) {
      reject("prepared state has invalid ownership metadata");
    }
    if (state.resources.some(({ owner }) => owner !== state.prefix)) {
      reject("prepared state contains a resource owned by another prefix");
    }
    const requiredResource = (kind, pattern) => {
      const matches = state.resources.filter(
        (resource) => resource.kind === kind && resource.status === "ready",
      );
      if (matches.length !== 1 || !pattern.test(matches[0].name ?? "")) {
        reject(`prepared state does not contain one owned ${kind}`);
      }
      return matches[0];
    };
    requiredResource("compose-postgres", /^openclaw_ci_pg_/);
    const cluster = requiredResource("k3d-cluster", /^openclaw-k8s-/);
    const environment = Object.fromEntries(
      readFileSync(environmentPath, "utf8")
        .split("\n")
        .filter(Boolean)
        .map((line) => {
          const separator = line.indexOf("=");
          return [line.slice(0, separator), line.slice(separator + 1)];
        }),
    );
    if (
      environment.OCC_TEST_KUBERNETES_KUBECONFIG !== cluster.kubeconfig ||
      environment.OCC_TEST_KUBERNETES_CONTEXT !== cluster.context
    ) {
      reject("prepared environment does not select the owned OpenShell cluster");
    }
  ' "$state_file" "$prepared_env_file" "$repo_root"
}

read_environment_field() {
  node -e '
    const { readFileSync } = require("node:fs");
    const name = process.argv[2];
    const line = readFileSync(process.argv[1], "utf8")
      .split("\n")
      .find((entry) => entry.startsWith(`${name}=`));
    if (!line) process.exit(1);
    process.stdout.write(`${line.slice(name.length + 1)}\n`);
  ' "$prepared_env_file" "$1"
}

release_lifecycle_lock() {
  if [ "$(readlink "$lifecycle_lock" 2>/dev/null || true)" = "${lifecycle_owner:-}" ]; then
    rm -f "$lifecycle_lock"
  fi
}

acquire_lifecycle_lock() {
  lifecycle_owner="$$:$action"
  if ! ln -s "$lifecycle_owner" "$lifecycle_lock" 2>/dev/null; then
    existing_owner="$(readlink "$lifecycle_lock" 2>/dev/null || true)"
    existing_pid="${existing_owner%%:*}"
    existing_action="${existing_owner#*:}"
    case "$existing_pid" in
      "" | *[!0-9]*) fail "lifecycle lock is unreadable; remove $lifecycle_lock if no OpenShell command is running" ;;
    esac
    if kill -0 "$existing_pid" 2>/dev/null; then
      fail "an OpenShell $existing_action command is already running (PID $existing_pid)"
    fi
    rm -f "$lifecycle_lock"
    ln -s "$lifecycle_owner" "$lifecycle_lock" 2>/dev/null || fail "another OpenShell command acquired the lifecycle lock"
  fi
  trap release_lifecycle_lock EXIT
}

case "$action" in
  up | test | down) acquire_lifecycle_lock ;;
esac

if [ "$action" = "info" ]; then
  if [ -f "$state_file" ] && [ -f "$prepared_env_file" ] && [ -f "$ready_file" ]; then
    validate_prepared_environment
    prepared_status="ready"
    kubeconfig="$(read_environment_field OCC_TEST_KUBERNETES_KUBECONFIG)"
    context="$(read_environment_field OCC_TEST_KUBERNETES_CONTEXT)"
  elif [ -f "$state_file" ] || [ -f "$prepared_env_file" ] || [ -f "$ready_file" ]; then
    prepared_status="incomplete; run ./scripts/openshell down"
    kubeconfig="not available"
    context="not available"
  else
    prepared_status="not prepared"
    kubeconfig="not available"
    context="not available"
  fi
  cat <<EOF
OpenShell verification environment
  Engine:           $engine_label
  State directory:  $state_dir
  Prepared state:   $prepared_status
  OpenShell:        v0.1.0-pre.7 compatibility bridge
  Kubeconfig:       $kubeconfig
  Context:          $context
EOF
  exit 0
fi

if [ "$action" = "get" ]; then
  [ -f "$state_file" ] && [ -f "$prepared_env_file" ] && [ -f "$ready_file" ] || fail "prepared environment is unavailable; run './scripts/openshell up' first"
  validate_prepared_environment
  case "$value_field" in
    kubeconfig) read_environment_field OCC_TEST_KUBERNETES_KUBECONFIG ;;
    context) read_environment_field OCC_TEST_KUBERNETES_CONTEXT ;;
    *) fail "unknown field '$value_field'; run './scripts/openshell help' for available fields" ;;
  esac
  exit 0
fi

if [ "$action" = "down" ]; then
  if [ ! -f "$state_file" ]; then
    echo "$engine_label-backed OpenShell environment is already down."
    exit 0
  fi
  info "Removing the owned cluster, images, and PostgreSQL resources."
  node scripts/ci/cleanup.mjs --state "$state_file"
  rm -f "$prepared_env_file" "$ready_file"
  echo "$engine_label-backed OpenShell environment removed."
  exit 0
fi

validate_credential_env_file
for command in helm openssl; do
  require_command "$command"
done
select_corepack
export OPENCLAW_CI_COREPACK_BIN="$corepack_bin"
prompt_openai_api_key

NODE_BASE_IMAGE="$(sed -n 's/^ARG NODE_BASE_IMAGE=//p' deploy/runtime/Dockerfile | head -1)"
export NODE_BASE_IMAGE
[ -n "$NODE_BASE_IMAGE" ] || fail "deploy/runtime/Dockerfile does not declare NODE_BASE_IMAGE"

if [ ! -f "$state_file" ]; then
  info "Preparing a disposable OpenShell cluster, PostgreSQL database, and runtime images."
  if ! "$container_bin" image inspect "$NODE_BASE_IMAGE" >/dev/null 2>&1; then
    "$container_bin" pull "$NODE_BASE_IMAGE"
  fi
  "${node_command[@]}" scripts/ci/prepare.mjs \
    --lane openshell \
    --state "$state_file" \
    --github-env "$prepared_env_file"
  "${node_command[@]}" scripts/ci/prepare.mjs \
    --lane openshell \
    --file tests/integration/sandbox-driver-openshell-k3d-real.test.mjs \
    --state "$state_file" \
    --github-env "$prepared_env_file"
  touch "$ready_file"
elif [ ! -f "$prepared_env_file" ] || [ ! -f "$ready_file" ]; then
  fail "preparation state is incomplete; run './scripts/openshell down' before retrying"
else
  info "Reusing the prepared OpenShell cluster, PostgreSQL database, and runtime images."
fi

validate_prepared_environment
load_environment

if [ "$action" = "test" ]; then
  info "Running the real OpenShell model and containment integration case."
  "${node_command[@]}" \
    --test \
    --test-name-pattern='OpenShell enforces the selected Secret projection contract' \
    tests/integration/sandbox-driver-openshell-k3d-real.test.mjs
  echo "OpenShell verification integration passed."
fi

cat <<EOF
OpenShell verification environment is ready.
OpenShell:   v0.1.0-pre.7 compatibility bridge
Kubeconfig: $(read_environment_field OCC_TEST_KUBERNETES_KUBECONFIG)
Context:    $(read_environment_field OCC_TEST_KUBERNETES_CONTEXT)

Run the real proof:
  ./scripts/openshell test

Inspect the environment:
  ./scripts/openshell info

Cleanup:
  ./scripts/openshell down
EOF
