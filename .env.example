# These nonsecret credentials are exclusively for the loopback-only local Compose database.
OCC_DATABASE_URL=postgresql://occ_app:occ-app-local@127.0.0.1:55432/openclaw_enterprise
OCC_MIGRATION_DATABASE_URL=postgresql://occ_migrator:occ-migrator-local@127.0.0.1:55432/openclaw_enterprise
OCC_DATABASE_POOL_MAX=10
OCC_POSTGRES_PORT=55432

# Docker development stack. Set OCC_DOCKER_RUNTIME_IMAGE when one image contains
# both the OpenClaw gateway and Codex app-server runtimes, or set the two image
# variables separately.
OPENCLAW_DEV_PORT=3000
OCC_DEVELOPMENT_TRUSTED_BRIDGE_CIDR=172.30.41.0/24
OCC_DEVELOPMENT_CONFIGURATION_ROOT=/app/.development/configurations
OCC_DOCKER_RUNTIME_IMAGE=
OCC_DOCKER_GATEWAY_IMAGE=
OCC_DOCKER_AGENT_IMAGE=
OPENCLAW_DEV_EMAIL=admin@openclaw.local
OPENCLAW_DEV_PASSWORD=openclaw-development-password
OPENCLAW_DEV_INSTALLATION_NAME=OpenClaw Local Development

# Direct local controller startup writes the initial administrator service key
# to this nonsecret path value. Choose a private absolute path in a 0700
# operator-owned directory before the first startup.
OCC_BOOTSTRAP_SERVICE_KEY_FILE=/absolute/private/openclaw-bootstrap/initial-admin-service-key.json

OPENAI_API_KEY=
