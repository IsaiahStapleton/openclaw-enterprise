{
  "uid": "occ-development",
  "title": "OCC development",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "tags": ["occ", "development"],
  "panels": [
    {
      "id": 1,
      "title": "Scrape health",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "occ-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=~\"occ-api|occ-worker\"}",
          "legendFormat": "{{service}} {{outcome}} {{deployment_state}} {{status_class}} {{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Agents by selected revision",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "occ-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (deployment_state) (occ_agents and on (job, instance, cluster, installation) (up == 1))",
          "legendFormat": "{{service}} {{outcome}} {{deployment_state}} {{status_class}} {{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Requests per second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "occ-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status_class) (rate(occ_http_requests_total[1m]))",
          "legendFormat": "{{service}} {{outcome}} {{deployment_state}} {{status_class}} {{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "HTTP p95 (seconds)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "occ-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(occ_http_request_duration_seconds_bucket[1m])))",
          "legendFormat": "{{service}} {{outcome}} {{deployment_state}} {{status_class}} {{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Reconciliation passes per second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "occ-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(occ_reconciliation_attempts_total[1m]))",
          "legendFormat": "{{service}} {{outcome}} {{deployment_state}} {{status_class}} {{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Pending work (shared)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "occ-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max (occ_work_pending and on (job, instance, cluster, installation) (up == 1))",
          "legendFormat": "{{service}} {{outcome}} {{deployment_state}} {{status_class}} {{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "Resident memory by process",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "occ-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "occ_process_resident_memory_bytes",
          "legendFormat": "{{service}} {{outcome}} {{deployment_state}} {{status_class}} {{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "title": "CPU cores by process",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "occ-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(occ_process_cpu_seconds_total[1m])",
          "legendFormat": "{{service}} {{outcome}} {{deployment_state}} {{status_class}} {{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "title": "Event-loop maximum lag",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "occ-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "occ_nodejs_eventloop_lag_max_seconds",
          "legendFormat": "{{service}} {{outcome}} {{deployment_state}} {{status_class}} {{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    }
  ]
}
